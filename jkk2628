<!-- MODAL -->
<div class="modal-backdrop" id="modalBackdrop" onclick="closeModal(event)">
  <div class="modal" id="modal">
    <button class="modal-close" onclick="closeModalDirect()">✕</button>
    <div class="modal-photo" id="modalPhoto"><span>👤</span></div>
    <div class="modal-role" id="modalRole"></div>
    <div class="modal-name" id="modalName"></div>
    <div class="modal-dept" id="modalDept" style="display:none"></div>
    <br>
    <button class="modal-upload-btn" id="modalUploadBtn">📷 Muat Naik Foto</button>
    <input type="file" id="modalFileInput" accept="image/*" style="display:none">
  </div>
</div>

<script>
  // ── Logo upload ──
  const logoWrap = document.getElementById('logoWrap');
  const logoInput = document.getElementById('logoInput');
  logoWrap.addEventListener('click', () => logoInput.click());
  logoInput.addEventListener('change', e => {
    const file = e.target.files[0];
    if (!file) return;
    const reader = new FileReader();
    reader.onload = ev => {
      logoWrap.innerHTML = `<img src="${ev.target.result}" alt="Logo IKRAM">`;
    };
    reader.readAsDataURL(file);
  });

  // ── Modal logic ──
  let activeCard = null;

  function openModal(card) {
    activeCard = card;
    const name = card.dataset.name;
    const role = card.dataset.role;
    const dept = card.dataset.dept;

    document.getElementById('modalName').textContent = name;
    document.getElementById('modalRole').textContent = role;

    const deptEl = document.getElementById('modalDept');
    if (dept) {
      deptEl.textContent = dept;
      deptEl.style.display = 'inline-block';
    } else {
      deptEl.style.display = 'none';
    }

    // Mirror current photo
    const photoWrap = card.querySelector('.photo-wrap');
    const existingImg = photoWrap.querySelector('img');
    const modalPhoto = document.getElementById('modalPhoto');
    if (existingImg) {
      modalPhoto.innerHTML = `<img src="${existingImg.src}" alt="${name}" style="width:100%;height:100%;object-fit:cover;border-radius:50%;">`;
    } else {
      modalPhoto.innerHTML = '<span>👤</span>';
    }

    document.getElementById('modalBackdrop').classList.add('open');
  }

  function closeModal(e) {
    if (e.target === document.getElementById('modalBackdrop')) closeModalDirect();
  }

  function closeModalDirect() {
    document.getElementById('modalBackdrop').classList.remove('open');
    activeCard = null;
  }

  // Modal file upload
  document.getElementById('modalUploadBtn').addEventListener('click', () => {
    document.getElementById('modalFileInput').click();
  });

  document.getElementById('modalFileInput').addEventListener('change', e => {
    const file = e.target.files[0];
    if (!file || !activeCard) return;
    const reader = new FileReader();
    reader.onload = ev => {
      const src = ev.target.result;
      // Update card photo
      const photoWrap = activeCard.querySelector('.photo-wrap');
      photoWrap.innerHTML = `<img src="${src}" alt="foto">`;
      // Update modal photo
      document.getElementById('modalPhoto').innerHTML =
        `<img src="${src}" alt="foto" style="width:100%;height:100%;object-fit:cover;border-radius:50%;">`;
    };
    reader.readAsDataURL(file);
    e.target.value = '';
  });

  // Keyboard close
  document.addEventListener('keydown', e => {
    if (e.key === 'Escape') closeModalDirect();
  });
</script>

